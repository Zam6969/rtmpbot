# Discord bot token (Discord Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Your server's ID (right-click server icon -> Copy Server ID; needs Developer Mode on)
GUILD_ID=

# What DJs put in OBS as the "Server" field. Replace with your server's IP or domain.
RTMP_PUBLIC_URL=rtmp://YOUR.SERVER.IP/live

# Recordings shorter than this (seconds) are treated as accidental and deleted without uploading
MIN_RECORDING_SECONDS=120

# How long the bot waits for a DJ to pick a custom title before using the default
TITLE_WAIT_MINUTES=30

# Discord user IDs allowed to use admin commands (/youtube, /update, /uploads, /retryuploads), comma-separated
OWNER_IDS=464865517354614805

# Uploads per day before sets queue for the next day (YouTube's free quota allows about 6)
DAILY_UPLOAD_LIMIT=6
